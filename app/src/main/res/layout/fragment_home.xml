<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_login_background_v2"
    android:fitsSystemWindows="true">

    <!-- ESTADO 0: INFO POR DEFECTO (AGRUPADO CON IMAGEN) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_info_default"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_default"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_default">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/title_advice_inventory"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/margin_large" />

                <!-- Scroll para que quepan todos los consejos en pantallas chicas -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="400dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subtitle_advice_inventory_1"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="@dimen/text_subheading"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_default"
                            android:text="@string/content_advice_inventory_1"
                            android:textSize="@dimen/text_body" />

                        <Space
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/margin_small" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subtitle_advice_inventory_2"
                            android:textColor="@color/colorPrimaryDark"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_default"
                            android:text="@string/content_advice_inventory_2" />

                        <Space
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/margin_small" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subtitle_advice_inventory_3"
                            android:textColor="@color/colorPrimaryDark"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_default"
                            android:text="@string/content_advice_inventory_3" />

                        <Space
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/margin_small" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subtitle_advice_inventory_4"
                            android:textColor="@color/colorPrimaryDark"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_default"
                            android:text="@string/content_advice_inventory_4" />

                        <Space
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/margin_small" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subtitle_advice_inventory_6"
                            android:textColor="@color/colorPrimaryDark"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_default"
                            android:text="@string/content_advice_inventory_6" />

                        <Space
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/margin_large" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/footer_advice_inventory"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="@dimen/text_subheading"
                            android:textStyle="bold" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/iv_branding"
            android:layout_width="@dimen/im_dms_branding_width"
            android:layout_height="@dimen/im_dms_branding_height"
            android:src="@drawable/im_dms_branding"
            android:elevation="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ESTADO 1: INVITACIÓN A PARTICIPAR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_invitacion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="25dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_finalizo_conteo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicia el\nCONTEO 1"
                android:textAlignment="center"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tipo_conteo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/red"
                android:textSize="18sp"
                android:textStyle="italic|bold"
                android:visibility="gone"
                tools:text="DIFERENCIAL"
                tools:visibility="visible" />

            <!-- Timer se movio al Estado 2 (layout_espera) -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="¿Participar en el siguiente\nconteo?"
                android:textAlignment="center"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_no_participa"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="40dp"
                    android:background="@drawable/bg_button_red_outline"
                    android:src="@drawable/ic_close"
                    android:scaleType="fitCenter"
                    android:padding="25dp"
                    app:tint="@color/red" />

                <ImageButton
                    android:id="@+id/btn_si_participa"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_button_green_outline"
                    android:src="@drawable/ic_check"
                    android:scaleType="fitCenter"
                    android:padding="25dp"
                    app:tint="@color/green" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ESTADO 2: ESPERANDO OTROS -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_espera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="25dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esperando respuesta de los\notros operadores ..."
                android:textAlignment="center"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:textColor="@color/red"
                android:textSize="40sp"
                android:textStyle="bold"
                tools:text="02:00" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Estado de participación:"
                android:textColor="@android:color/darker_gray"
                android:textStyle="italic" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_estado_operadores"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                tools:listitem="@layout/item_operator_status" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ESTADO 3: LISTA DE PRODUCTOS ASIGNADOS -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_lista_asignados"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardCornerRadius="25dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_header_reparto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:text="Busca los productos y\nvuelve a contarlos"
                android:textAlignment="center"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_productos_asignados"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="100dp"
                tools:listitem="@layout/item_home_assigned" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
