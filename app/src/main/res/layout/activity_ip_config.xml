<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".features.config.ip.ConfigIpActivity">



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#fdfbfd"
        android:padding="@dimen/margin_default"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:gravity="center"
            android:text="Para que el aplicativo funcione correctamente, debe asegurarse de usar la IP correcta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_default"
            android:text="IP Actual"
            android:textColor="@android:color/black"
            android:textSize="@dimen/text_caption"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
            android:focusable="true"
            android:focusableInTouchMode="true"
            />

        <EditText
            android:id="@+id/et_ip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:clickable="false"
            android:cursorVisible="false"
            android:enabled="true"
            android:focusable="false"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:text="https://172.98.41.23/"
            android:textSize="@dimen/text_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_label" />

        <ImageView
            android:id="@+id/iv_scanning"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/bt_scan"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_ip" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bt_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_default"
            app:icon="@drawable/ic_camera"
            app:iconPadding="10dp"
            app:iconGravity="textEnd"
            android:drawableTint="@color/textColorPrimary"
            android:text="Escanear"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textSize="@dimen/text_body"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="20dp"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/colorPrimaryDark"
            app:layout_constraintBottom_toTopOf="@id/btn_finish_config"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!--        <androidx.appcompat.widget.AppCompatButton-->
        <!--            android:id="@+id/bt_manual"-->
        <!--            style="@style/Widget.AppCompat.Button.Borderless.Colored"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:text="Configuracion manual"-->
        <!--            android:textColor="@color/colorPrimary"-->
        <!--            android:textSize="@dimen/text_body"-->
        <!--            android:layout_marginHorizontal="30dp"-->
        <!--            app:layout_constraintBottom_toBottomOf="parent"-->
        <!--            app:layout_constraintEnd_toEndOf="parent"-->
        <!--            app:layout_constraintStart_toStartOf="parent" />-->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_finish_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginHorizontal="30dp"
            android:text="Finalizar configuración"
            android:textAllCaps="false"
            app:cornerRadius="10dp"
            style="?attr/materialButtonOutlinedStyle"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
