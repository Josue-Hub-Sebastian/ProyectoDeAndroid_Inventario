<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_teclado_calculadora"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:columnCount="4"
    android:rowCount="4"
    android:padding="2dp"
    android:background="@color/windowBackground">

    <!-- Fila 1 -->
    <Button android:id="@+id/btn7" style="@style/BotonTecladoNumero" android:text="7" android:layout_row="0" android:layout_column="0"/>
    <Button android:id="@+id/btn8" style="@style/BotonTecladoNumero" android:text="8" android:layout_row="0" android:layout_column="1"/>
    <Button android:id="@+id/btn9" style="@style/BotonTecladoNumero" android:text="9" android:layout_row="0" android:layout_column="2"/>
    <Button android:id="@+id/btnLimpiar" style="@style/BotonTecladoAccion" android:text="C" android:layout_row="0" android:layout_column="3"/>

    <!-- Fila 2 -->
    <Button android:id="@+id/btn4" style="@style/BotonTecladoNumero" android:text="4" android:layout_row="1" android:layout_column="0"/>
    <Button android:id="@+id/btn5" style="@style/BotonTecladoNumero" android:text="5" android:layout_row="1" android:layout_column="1"/>
    <Button android:id="@+id/btn6" style="@style/BotonTecladoNumero" android:text="6" android:layout_row="1" android:layout_column="2"/>
    <Button android:id="@+id/btnBorrar" style="@style/BotonTecladoAccion" android:text="⌫" android:layout_row="1" android:layout_column="3"/>

    <!-- Fila 3 -->
    <Button android:id="@+id/btn1" style="@style/BotonTecladoNumero" android:text="1" android:layout_row="2" android:layout_column="0"/>
    <Button android:id="@+id/btn2" style="@style/BotonTecladoNumero" android:text="2" android:layout_row="2" android:layout_column="1"/>
    <Button android:id="@+id/btn3" style="@style/BotonTecladoNumero" android:text="3" android:layout_row="2" android:layout_column="2"/>
    <Button android:id="@+id/btnSuma" style="@style/BotonTecladoOperador" android:text="+" android:layout_row="2" android:layout_column="3"/>

    <!-- Fila 4 -->
    <Button android:id="@+id/btn0" style="@style/BotonTecladoNumero" android:text="0" android:layout_row="3" android:layout_column="0"/>
    <Button android:id="@+id/btnPunto" style="@style/BotonTecladoNumero" android:text="." android:layout_row="3" android:layout_column="1"/>
    <Button android:id="@+id/btnIgual" style="@style/BotonTecladoIgual" android:text="=" android:layout_row="3" android:layout_column="2"/>
    <Button android:id="@+id/btnMultiplicacion" style="@style/BotonTecladoOperador" android:text="×" android:layout_row="3" android:layout_column="3"/>

</GridLayout>
