<?xml version="1.0" encoding="utf-8"?>
<com.daimajia.swipe.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/margin_small"
    android:layout_marginStart="@dimen/margin_default">

    <LinearLayout
        android:id="@+id/ly_delete"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="#484848"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_delete"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eliminar"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#ffffff"
            android:padding="@dimen/margin_default">

            <TextView
                android:id="@+id/tv_descripcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_default"
                android:textColor="@android:color/black"
                android:textSize="@dimen/text_body"
                app:layout_constraintEnd_toStartOf="@+id/tv_cantidad"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="BW HUG NAT REFRESH REF 3X184" />

            <TextView
                android:id="@+id/tv_codigo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_default"
                android:textSize="@dimen/text_caption"
                app:layout_constraintEnd_toStartOf="@+id/tv_cantidad"
                app:layout_constraintStart_toStartOf="@id/tv_descripcion"
                app:layout_constraintTop_toBottomOf="@id/tv_descripcion"
                tools:text="32847329587234" />

            <TextView
                android:id="@+id/tv_cantidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="@dimen/text_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="44" />

            <TextView
                android:id="@+id/ubicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xsmall"
                android:text="Ubicacion:"
                android:textSize="@dimen/text_caption"
                app:layout_constraintStart_toStartOf="@id/tv_descripcion"
                app:layout_constraintTop_toBottomOf="@id/tv_codigo" />

            <TextView
                android:id="@+id/lote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xsmall"
                android:text="Lote:"
                android:textSize="@dimen/text_caption"
                app:layout_constraintStart_toStartOf="@id/tv_descripcion"
                app:layout_constraintTop_toBottomOf="@id/ubicacion" />

            <TextView
                android:id="@+id/serie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xsmall"
                android:text="Serie:"
                android:textSize="@dimen/text_caption"
                app:layout_constraintStart_toStartOf="@id/tv_descripcion"
                app:layout_constraintTop_toBottomOf="@id/lote" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="end"
                app:constraint_referenced_ids="ubicacion, lote, serie" />

            <TextView
                android:id="@+id/tv_ubicacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_default"
                android:layout_marginStart="@dimen/margin_small"
                android:textColor="@android:color/black"
                android:textSize="@dimen/text_caption"
                app:layout_constraintBaseline_toBaselineOf="@id/ubicacion"
                app:layout_constraintEnd_toStartOf="@+id/tv_cantidad"
                app:layout_constraintStart_toEndOf="@id/barrier"
                tools:text="A01" />

            <TextView
                android:id="@+id/tv_lote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_default"
                android:layout_marginStart="@dimen/margin_small"
                android:textColor="@android:color/black"
                android:textSize="@dimen/text_caption"
                app:layout_constraintBaseline_toBaselineOf="@id/lote"
                app:layout_constraintEnd_toStartOf="@+id/tv_cantidad"
                app:layout_constraintStart_toEndOf="@id/barrier"
                tools:text="AAAAAA" />

            <TextView
                android:id="@+id/tv_serie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_default"
                android:layout_marginStart="@dimen/margin_small"
                android:textColor="@android:color/black"
                android:textSize="@dimen/text_caption"
                app:layout_constraintBaseline_toBaselineOf="@id/serie"
                app:layout_constraintEnd_toStartOf="@+id/tv_cantidad"
                app:layout_constraintStart_toEndOf="@id/barrier"
                tools:text="SDADKFJADALDK" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/colorPrimary" />
    </FrameLayout>

</com.daimajia.swipe.SwipeLayout>